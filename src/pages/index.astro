---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
import HelpSection from '../components/HelpSection.astro';
import Loading from '../components/Loading.astro';
---

<Layout title="Get Help Now - Rising Again">
  <main class="min-h-screen bg-white">
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-teal-600 via-teal-700 to-teal-800 text-white py-16 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl md:text-6xl font-black mb-6 leading-tight">
          Get Help <span class="text-teal-200">Right Now</span>
        </h1>
        <p class="text-xl md:text-2xl mb-8 opacity-95 max-w-2xl mx-auto leading-relaxed">
          Find the support you need in just two clicks. We're here to help you get back on your feet.
        </p>
      </div>
    </section>

    <HelpSection />

  </main>

  <Loading />
</Layout>
