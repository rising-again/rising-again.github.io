---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="About Our Mission">
  <section class="py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="flex justify-center lg:justify-start">
          <div class="w-64 h-64 bg-gradient-to-br from-teal-100 to-cyan-100 rounded-full flex items-center justify-center shadow-2xl">
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="bi bi-house-heart-fill w-40 h-40 text-blue-500" viewBox="0 0 16 16">
              <path d="M7.293 1.5a1 1 0 0 1 1.414 0L11 3.793V2.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v3.293l2.354 2.353a.5.5 0 0 1-.708.707L8 2.207 1.354 8.853a.5.5 0 1 1-.708-.707z"/>
              <path d="m14 9.293-6-6-6 6V13.5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5zm-6-.811c1.664-1.673 5.825 1.254 0 5.018-5.825-3.764-1.664-6.691 0-5.018"/>
            </svg>
          </div>
        </div>

        <div class="text-center lg:text-left">
          <h2 class="text-3xl lg:text-4xl font-black text-gray-900 mb-4">
            Our Mission: Connecting Kentuckians to Help
          </h2>
          <p class="text-lg text-gray-600 leading-relaxed mb-6">
            We believe everyone in Kentucky deserves access to essential resources.
            Our platform is dedicated to simplifying the search for assistance by providing clear, reliable information on housing, food, finance, and more.
            We focus on cutting through the confusion by dispelling common myths and presenting verified facts, so you can confidently find the support you need.
          </p>
          <p class="text-lg text-gray-600 leading-relaxed">
            Whether you're a veteran seeking specific programs, a senior looking for benefits, or a family in need of support, we are here to help you navigate your options and get connected.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>