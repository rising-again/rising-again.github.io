---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import type { ManifestItem } from "../utils/manifest";
import { slugify } from "../utils/manifest";

export interface Props {
  topic: string;
  audience: string;
  articles: ManifestItem[];
  breadcrumbs?: Array<{name: string, href: string}>;
}

const { topic, audience, articles, breadcrumbs = [] } = Astro.props;

// Capitalize first letter for display
function capitalize(str: string | undefined): string {
  if (!str) return '';
  return str.charAt(0).toUpperCase() + str.slice(1);
}

const pageTitle = `${capitalize(topic)} Resources for ${capitalize(audience)}`;
---

<Layout
  title={pageTitle}
  showBreadcrumbs={breadcrumbs.length > 0}
  breadcrumbs={breadcrumbs}
>

<div class="bg-white">
  <!-- Articles List -->
  <section class="py-16">
    <div class="max-w-6xl mx-auto px-4">
      {articles.length === 0 ? (
        <!-- No Articles Found -->
        <div class="text-center py-16">
          <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-12 h-12 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">No Resources Found</h2>
          <p class="text-gray-600 mb-8">
            We don't currently have {topic} resources available{audience ? ` for ${audience === 'other' ? 'the general public' : `${audience}s`}` : ''}.
          </p>
          <a href="/" class="bg-teal-600 hover:bg-teal-700 text-white font-semibold py-3 px-8 rounded-lg shadow-lg transition-all transform hover:scale-105 inline-flex items-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
            </svg>
            Find Other Resources
          </a>
        </div>
      ) : (
        <>
          <div class="text-center mb-12">
            <h2 class="text-3xl lg:text-4xl font-black text-gray-900 mb-4">Available Resources</h2>
            <p class="text-lg text-gray-600 max-w-3xl mx-auto">
              {articles.length === 1 ? 'We found 1 resource' : `We found ${articles.length} resources`} that match your needs.
              Click on any resource below to get detailed information.
            </p>
          </div>

          <div class="grid gap-8 max-w-4xl mx-auto">
            {articles.map((article, index) => (
              <div class="bg-white border-2 border-gray-200 rounded-2xl shadow-lg hover:shadow-xl hover:border-teal-300 transition-all transform hover:-translate-y-1 overflow-hidden">
                <div class="p-8">
                  <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-6">
                    <div class="flex-1">
                      <h3 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-4 leading-tight">
                        {article.title}
                      </h3>
                      <p class="text-lg text-gray-600 mb-6 leading-relaxed">
                        {article.description}
                      </p>

                      <!-- Resource Features -->
                      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                        {article.truths.length > 0 && (
                          <div class="flex items-center gap-3 bg-teal-50 border border-teal-200 rounded-lg px-4 py-3">
                            <div class="w-8 h-8 bg-teal-500 rounded-full flex items-center justify-center">
                              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                              </svg>
                            </div>
                            <span class="font-semibold text-teal-800">
                              {article.truths.length} Verified Facts
                            </span>
                          </div>
                        )}

                        {article.myths.length > 0 && (
                          <div class="flex items-center gap-3 bg-purple-50 border border-purple-200 rounded-lg px-4 py-3">
                            <div class="w-8 h-8 bg-purple-500 rounded-full flex items-center justify-center">
                              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                              </svg>
                            </div>
                            <span class="font-semibold text-purple-800">
                              {article.myths.length} Myths Debunked
                            </span>
                          </div>
                        )}
                      </div>

                      <!-- Contact Info Preview -->
                      {(article.contact.phone || article.contact.email) && (
                        <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 mb-6">
                          <div class="flex items-center gap-3 mb-2">
                            {/* <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                            </svg> */}
                            <span class="font-semibold text-gray-900">Direct Contact Available</span>
                          </div>
                          <div class="text-sm text-gray-600 flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-0">
                            {article.contact.phone && <a href={`tel:${article.contact.phone}`}>Phone: {article.contact.phone}</a>}
                            {article.contact.phone && article.contact.email && <a class="hidden sm:inline"> • </a>}
                            {article.contact.email && <a href={`mailto:${article.contact.email}`}>  Mail: {article.contact.email}</a>}
                          </div>
                        </div>
                      )}

                      <!-- Audience Tags -->
                      <div class="flex flex-wrap gap-2 mb-6">
                        {article.audience?.map((aud) => (
                          aud && (
                            <span class="bg-teal-100 text-teal-800 text-sm font-semibold px-3 py-1 rounded-full">
                              {capitalize(aud)}
                            </span>
                          )
                        ))}
                      </div>
                    </div>

                    <!-- Call-to-Action -->
                    <div class="flex-shrink-0 w-full lg:w-auto mt-6 lg:mt-0">
                      <a
                        href={audience ? `/${topic}/${audience}/${slugify(article.title)}` : `/${topic}/${article.audience[0]}/${slugify(article.title)}`}
                        class="w-full lg:w-auto bg-gradient-to-r from-teal-600 to-cyan-600 hover:from-teal-700 hover:to-cyan-700 text-white font-bold py-4 px-8 rounded-xl shadow-lg transition-all transform hover:scale-105 inline-flex items-center justify-center gap-3 whitespace-nowrap"
                      >
                        <span>View Details</span>
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 111.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                        </svg>
                      </a>
                    </div>
                  </div>
                </div>

                <!-- Bottom border accent -->
                <div class="h-2 bg-gradient-to-r from-teal-500 to-cyan-500"></div>
              </div>
            ))}
          </div>
        </>
      )}
    </div>
  </section>

  <!-- Bottom Navigation -->
  <section class="bg-gray-900 text-white py-8">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h3 class="text-xl font-bold mb-4">Need Different Resources?</h3>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="bg-teal-600 hover:bg-teal-700 text-white font-semibold py-3 px-8 rounded-lg shadow-lg transition-all transform hover:scale-105 flex items-center justify-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
          </svg>
          Browse All Resources
        </a>
        <a href={audience ? `/${topic}` : "/"} class="bg-gray-700 hover:bg-gray-600 text-white font-semibold py-3 px-8 rounded-lg shadow-lg transition-all transform hover:scale-105 flex items-center justify-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd"/>
          </svg>
          {audience ? `All Resources for ${capitalize(topic)}` : 'View All Topics'}
        </a>
      </div>
    </div>
  </section>
</div>
</Layout>

<style>
@media print {
  .shadow-sm, .shadow-md, .shadow-lg, .shadow-xl, .shadow-2xl {
    box-shadow: none !important;
  }

  .bg-gradient-to-r, .bg-gradient-to-br {
    background: #374151 !important;
    color: white !important;
  }

  body {
    font-size: 12pt !important;
    line-height: 1.4 !important;
  }

  h1 { font-size: 24pt !important; }
  h2 { font-size: 20pt !important; }
  h3 { font-size: 16pt !important; }
}
</style>