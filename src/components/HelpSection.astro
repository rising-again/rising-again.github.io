---
import { loadManifest, getAvailableTopics, getAvailableAudiences } from '../utils/manifest';
import { Image } from 'astro:assets';
// import logo  from '../assets/logo_COLOR.svg';
import logo  from '../assets/logo_COLOR_colorLayer.svg';
const manifest = loadManifest();
const availableTopics = getAvailableTopics(manifest);

// Create topic configurations
const topicConfigs = {
  housing: {
    tag: "housing",
    title: "Housing",
    description: "Emergency shelter, temporary housing, rental assistance, and permanent housing solutions.",
    color: "teal",
    icon: `<path d="M6.5 14.5v-3.505c0-.245.25-.495.5-.495h2c.25 0 .5.25.5.5v3.5a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5"/>`
  },
  food: {
    tag: "food",
    title: "Food",
    description: "Food banks, meal programs, SNAP benefits, and nutrition assistance for families.",
    color: "green",
    icon: `<path d="M13 .5c0-.276-.226-.506-.498-.465-1.703.257-2.94 2.012-3 8.462a.5.5 0 0 0 .498.5c.56.01 1 .13 1 1.003v5.5a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5zM4.25 0a.25.25 0 0 1 .25.25v5.122a.128.128 0 0 0 .256.006l.233-5.14A.25.25 0 0 1 5.24 0h.522a.25.25 0 0 1 .25.238l.233 5.14a.128.128 0 0 0 .256-.006V.25A.25.25 0 0 1 6.75 0h.29a.5.5 0 0 1 .498.458l.423 5.07a1.69 1.69 0 0 1-1.059 1.711l-.053.022a.92.92 0 0 0-.58.884L6.47 15a.971.971 0 1 1-1.942 0l.202-6.855a.92.92 0 0 0-.58-.884l-.053-.022a1.69 1.69 0 0 1-1.059-1.712L3.462.458A.5.5 0 0 1 3.96 0z"/>`
  },
  healthcare: {
    tag: "healthcare",
    title: "Healthcare",
    description: "Medical care, mental health services, prescription assistance, and health insurance.",
    color: "blue",
    icon: `<path d="M1.475 9C2.702 10.84 4.779 12.871 8 15c3.221-2.129 5.298-4.16 6.525-6H12a.5.5 0 0 1-.464-.314l-1.457-3.642-1.598 5.593a.5.5 0 0 1-.945.049L5.889 6.568l-1.473 2.21A.5.5 0 0 1 4 9z"/>
           <path d="M.88 8C-2.427 1.68 4.41-2 7.823 1.143q.09.083.176.171a3 3 0 0 1 .176-.17C11.59-2 18.426 1.68 15.12 8h-2.783l-1.874-4.686a.5.5 0 0 0-.945.049L7.921 8.956 6.464 5.314a.5.5 0 0 0-.88-.091L3.732 8z"/>`
  },
  employment: {
    tag: "employment",
    title: "Jobs & Training",
    description: "Job placement, skills training, resume help, and unemployment assistance.",
    color: "purple",
    icon: `<path d="M6.5 1A1.5 1.5 0 0 0 5 2.5V3H1.5A1.5 1.5 0 0 0 0 4.5v1.384l7.614 2.03a1.5 1.5 0 0 0 .772 0L16 5.884V4.5A1.5 1.5 0 0 0 14.5 3H11v-.5A1.5 1.5 0 0 0 9.5 1zm0 1h3a.5.5 0 0 1 .5.5V3H6v-.5a.5.5 0 0 1 .5-.5"/>
          <path d="M0 12.5A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5V6.85L8.129 8.947a.5.5 0 0 1-.258 0L0 6.85z"/>`
  },
  financial: {
    tag: "financial",
    title: "Financial Aid",
    description: "Emergency funds, utility assistance, debt counseling, and financial planning.",
    color: "orange",
    icon: `<path fill-rule="evenodd" d="M11 15a4 4 0 1 0 0-8 4 4 0 0 0 0 8m5-4a5 5 0 1 1-10 0 5 5 0 0 1 10 0"/>
          <path d="M9.438 11.944c.047.596.518 1.06 1.363 1.116v.44h.375v-.443c.875-.061 1.386-.529 1.386-1.207 0-.618-.39-.936-1.09-1.1l-.296-.07v-1.2c.376.043.614.248.671.532h.658c-.047-.575-.54-1.024-1.329-1.073V8.5h-.375v.45c-.747.073-1.255.522-1.255 1.158 0 .562.378.92 1.007 1.066l.248.061v1.272c-.384-.058-.639-.27-.696-.563h-.668zm1.36-1.354c-.369-.085-.569-.26-.569-.522 0-.294.216-.514.572-.578v1.1zm.432.746c.449.104.655.272.655.569 0 .339-.257.571-.709.614v-1.195z"/>
          <path d="M1 0a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h4.083q.088-.517.258-1H3a2 2 0 0 0-2-2V3a2 2 0 0 0 2-2h10a2 2 0 0 0 2 2v3.528c.38.34.717.728 1 1.154V1a1 1 0 0 0-1-1z"/>
          <path d="M9.998 5.083 10 5a2 2 0 1 0-3.132 1.65 6 6 0 0 1 3.13-1.567"/>
        `
  },
  other: {
    tag: "other",
    title: "Other Support",
    description: "Transportation, legal aid, childcare, and other community services.",
    color: "gray",
    icon: `<path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0M5.496 6.033h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286a.237.237 0 0 0 .241.247m2.325 6.443c.61 0 1.029-.394 1.029-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94 0 .533.425.927 1.01.927z"/>`
  }
};

// Filter available topics based on manifest
const displayTopics = availableTopics.filter(topic => topicConfigs[topic]).map(topic => ({
  key: topic,
  ...topicConfigs[topic]
}));

// Get color classes
function getColorClasses(color: string) {
  const colorMap = {
    teal: { bg: "bg-teal-100", bgHover: "bg-teal-500", text: "text-teal-600", textHover: "text-teal-600" },
    green: { bg: "bg-green-100", bgHover: "bg-green-500", text: "text-green-600", textHover: "text-green-600" },
    blue: { bg: "bg-blue-100", bgHover: "bg-blue-500", text: "text-blue-600", textHover: "text-blue-600" },
    purple: { bg: "bg-purple-100", bgHover: "bg-purple-500", text: "text-purple-600", textHover: "text-purple-600" },
    orange: { bg: "bg-orange-100", bgHover: "bg-orange-500", text: "text-orange-600", textHover: "text-orange-600" },
    gray: { bg: "bg-gray-100", bgHover: "bg-gray-500", text: "text-gray-600", textHover: "text-gray-600" }
  };
  return colorMap[color] || colorMap.gray;
}
---
<section class="bg-teal-50 py-20 px-4">
<div class="flex flex-col md:flex-row items-stretch max-w-6xl mx-auto text-center gap-5">
  <Image
    src={logo}
    alt="Rising-Again logo"
    class="w-full max-w-xs sm:max-w-sm md:max-w-md h-auto object-contain mx-auto"
  />
  <div class="flex items-center">
    <div>
      <h1 class="text-4xl md:text-6xl font-extrabold text-gray-900 mb-6 leading-tight">
        Find Help to Rise Again
      </h1>
      <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto mb-10">
        Dedicated to connecting Veterans, Seniors, and families across Kentucky with the resources they need for housing, food, healthcare, and more.
      </p>
      <a href="#help-selection" class="inline-block bg-teal-500 hover:bg-teal-600 text-white font-bold py-3 px-8 rounded-full transition-colors duration-300 shadow-md">
        Explore Resources
      </a>
    </div>
  </div>
</div>
</section>
<!-- Help Selection -->
<section class="py-16 px-4" id="help-selection">
  <div class="max-w-6xl mx-auto">

    <div class="text-center mb-12">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        What kind of help do you need?
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Select the type of assistance you're looking for and we'll connect you with the right resources.
      </p>
    </div>

    {displayTopics.length === 0 ? (
      <div class="text-center py-16">
        <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-12 h-12 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-4">No Resources Available</h3>
        <p class="text-gray-600">We're currently setting up our resource database. Please check back soon.</p>
      </div>
    ) : (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {displayTopics.map((topic) => {
          const colors = getColorClasses(topic.color);
          return (
            <a
              data-type={topic.tag.toLowerCase()}
              class={`help-type-btn cursor-pointer bg-white border-2 border-gray-200 rounded-xl p-8 text-left hover:border-teal-500 hover:shadow-lg transition-all group`}
            >
              <div class="flex items-center gap-4 mb-4">
                <div class={`w-16 h-16 bg-${colors.text} rounded-full flex items-center justify-center  hover:${colors.bgHover} transition-colors`}>
                  <svg class={`w-10 h-10 ${colors.text} group-hover:${colors.textHover} transition-colors`} fill="currentColor" viewBox="0 -2 15 20">
                    <Fragment set:html={topic.icon} />
                  </svg>
                </div>
                <h3 class="text-2xl font-bold text-gray-900">{topic.title}</h3>
              </div>
              <p class="text-gray-600 mb-4">{topic.description}</p>
              <div class={`${colors.text} font-semibold flex items-center gap-2`}>
                Get {topic.title} Help
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 111.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>
</section>

<!-- Demographic Selection (Hidden by default) -->
<section class="hidden py-16 px-4 bg-gray-50" id="demographic-selection">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        Which describes you best?
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        This helps us show you the most relevant resources and programs available to you.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 max-w-3xl mx-auto" id="audience-options">
      <!-- Dynamic audience options will be inserted here -->
    </div>

    <div class="text-center mt-8">
      <a class="back-btn cursor-pointer inline-flex items-center gap-2 text-teal-600 hover:text-teal-700 font-semibold mb-4">
        <svg class="w-7 h-7" fill="currentColor" viewBox="0 -2 20 20">
          <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8"/>
        </svg>
        Back to Help Types
      </a>
    </div>
  </div>
</section>



<script define:vars={{ manifest, getAvailableAudiences }}>
  let selectedHelpType = '';
  let availableManifest = manifest;

  // Add event listeners to help type buttons
  document.querySelectorAll('.help-type-btn').forEach(button => {
    button.addEventListener('click', function() {
      const type = this.getAttribute('data-type');
      selectHelpType(type);
    });
  });

  // Add event listeners to demographic buttons
  document.querySelectorAll('.demographic-btn').forEach(button => {
    button.addEventListener('click', function() {
      const demographic = this.getAttribute('data-demographic');
      findResources(selectedHelpType, demographic);
    });
  });

  // Add event listener to back button
  document.querySelectorAll('.back-btn').forEach(button => {
    button.addEventListener('click', function() {
      goBack();
    });
  });

  // Audience configurations
  const audienceConfigs = {
    veteran: {
      title: "I'm a Veteran",
      description: "Military service members and veterans",
      icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-award-fill" viewBox="-0.5 -1 17 17">
            <path d="m8 0 1.669.864 1.858.282.842 1.68 1.337 1.32L13.4 6l.306 1.854-1.337 1.32-.842 1.68-1.858.282L8 12l-1.669-.864-1.858-.282-.842-1.68-1.337-1.32L2.6 6l-.306-1.854 1.337-1.32.842-1.68L6.331.864z"/>
            <path d="M4 11.794V16l4-1 4 1v-4.206l-2.018.306L8 13.126 6.018 12.1z"/>
          </svg>`
    },
    senior: {
      title: "I'm 65 or Older",
      description: "Senior citizens and elderly community members",
      icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-person-walking" viewBox="-0.5 -1 17 17">
            <path d="M9.5 1.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0M6.44 3.752A.75.75 0 0 1 7 3.5h1.445c.742 0 1.32.643 1.243 1.38l-.43 4.083a1.8 1.8 0 0 1-.088.395l-.318.906.213.242a.8.8 0 0 1 .114.175l2 4.25a.75.75 0 1 1-1.357.638l-1.956-4.154-1.68-1.921A.75.75 0 0 1 6 8.96l.138-2.613-.435.489-.464 2.786a.75.75 0 1 1-1.48-.246l.5-3a.75.75 0 0 1 .18-.375l2-2.25Z"/>
            <path d="M6.25 11.745v-1.418l1.204 1.375.261.524a.8.8 0 0 1-.12.231l-2.5 3.25a.75.75 0 1 1-1.19-.914zm4.22-4.215-.494-.494.205-1.843.006-.067 1.124 1.124h1.44a.75.75 0 0 1 0 1.5H11a.75.75 0 0 1-.531-.22Z"/>
          </svg>`
    },
    other: {
      title: "General Public",
      description: "Individuals and families seeking assistance",
      icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-person-fill" viewBox="-0.5 -1 17 17">
            <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
          </svg>`
    }
  };

  function selectHelpType(type) {
    selectedHelpType = type;
    // Get available audiences for this topic
    const availableAudiences = getAvailAudiences(availableManifest, type);

    // Show audience selection
    document.getElementById('help-selection').classList.add('hidden');
    document.getElementById('demographic-selection').classList.remove('hidden');

    // Populate audience options dynamically
    const audienceContainer = document.getElementById('audience-options');
    audienceContainer.innerHTML = '';

    availableAudiences.forEach(audience => {
      if (audienceConfigs[audience]) {
        const config = audienceConfigs[audience];
        const button = document.createElement('a');
        button.onclick = () => findResources(audience);
        button.className = 'demographic-btn cursor-pointer bg-white border-2 border-gray-200 rounded-xl p-8 text-center hover:border-teal-500 hover:shadow-lg transition-all group';
        button.innerHTML = `
          <div class="w-20 h-20 bg-teal-100 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-teal-500 transition-colors">
            <svg class="w-10 h-10 text-teal-600 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 20 20">
              ${config.icon}
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">${config.title}</h3>
          <p class="text-gray-600">${config.description}</p>
        `;
        audienceContainer.appendChild(button);
      }
    });

    // Smooth scroll to demographic section
    document.getElementById('demographic-selection').scrollIntoView({
      behavior: 'smooth'
    });
  }

  function goBack() {
    document.getElementById('demographic-selection').classList.add('hidden');
    document.getElementById('help-selection').classList.remove('hidden');

    // Smooth scroll back to help selection
    document.getElementById('help-selection').scrollIntoView({
      behavior: 'smooth'
    });
  }

  function findResources(audience) {
    // Navigate to the resource page
    window.location.href = `/${selectedHelpType}/${audience}`;
  }

  // Helper function to get available audiences (clientside version)
  function getAvailAudiences(manifest, topic) {
    const audiences = new Set();
    manifest
      .filter(item => item.topic === topic)
      .forEach(item => {
        item.audience.forEach(aud => audiences.add(aud));
      });
    return Array.from(audiences);
  }

  // Add keyboard navigation
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const loading = document.getElementById('loading');
      if (!loading.classList.contains('hidden')) {
        loading.classList.add('hidden');
      }
    }
  });
</script>