---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import type { ManifestItem } from "../utils/manifest";

export interface Props {
  resourceData: ManifestItem;
  articleContent?: string;
  breadcrumbs?: Array<{name: string, href: string}>;
}

const { resourceData, articleContent = '', breadcrumbs = [] } = Astro.props;
const { title, description, audience, topic, contact, truths, myths } = resourceData;

// Capitalize first letter for display
function capitalize(str: string | undefined): string {
  if (!str) return '';
  return str.charAt(0).toUpperCase() + str.slice(1);
}

// convert address to google maps url
function locationToURL(location: string): string {
    return "https://www.google.com/maps/place/"+ encodeURIComponent(location.replaceAll(" ", "+"))
}
---

<Layout
  title={title}
  description={description}
  showBreadcrumbs={breadcrumbs.length > 0}
  breadcrumbs={breadcrumbs}
>

<!-- SEO and Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "GovernmentService",
  "name": title,
  "description": description,
  "serviceType": capitalize(topic),
  "audience": audience?.map(a => capitalize(a)),
  "provider": {
    "@type": "GovernmentOrganization",
    "name": "Rising Again",
    "url": "/"
  },
  "areaServed": "Kentucky",
  "contactPoint": contact.phone ? {
    "@type": "ContactPoint",
    "telephone": contact.phone,
    "email": contact.email || undefined,
    "contactType": "customer service"
  } : undefined
})} />

<div class="bg-gray-50">
  <!-- Accessibility Controls -->
  <div class="sticky top-16 z-40 bg-gray-800 text-white px-4 py-2 print:hidden">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <div class="flex items-center gap-4">
        <span class="text-sm font-semibold">Text Size:</span>
        <div class="flex gap-1">
          <button id="font-small" class="w-8 h-8 bg-gray-700 hover:bg-gray-600 rounded text-xs font-bold transition-all" aria-label="Decrease font size">A-</button>
          <button id="font-normal" class="w-8 h-8 bg-gray-700 hover:bg-gray-600 rounded text-xs font-bold transition-all" aria-label="Normal font size">A</button>
          <button id="font-large" class="w-8 h-8 bg-gray-700 hover:bg-gray-600 rounded text-xs font-bold transition-all" aria-label="Increase font size">A+</button>
        </div>
      </div>
      <button id="print-btn" class="flex items-center gap-2 bg-teal-600 hover:bg-teal-700 px-3 py-1 rounded text-sm font-semibold transition-all" aria-label="Print this page">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path fill-rule="evenodd" d="M5 4v3H4a2 2 0 00-2 2v3a2 2 0 002 2h1v2a2 2 0 002 2h6a2 2 0 002-2v-2h1a2 2 0 002-2V9a2 2 0 00-2-2h-1V4a2 2 0 00-2-2H7a2 2 0 00-2 2zm8 0H7v3h6V4zM5 14H4v-3h1v3zm6 0H9v2H7v-2H6v3h8v-3h-3zm2-3h1V9h-1v2z" clip-rule="evenodd"></path>
        </svg>
        Print
      </button>
    </div>
  </div>

<!-- Hero Section with Subtle Animation -->
<header class="bg-gradient-to-br from-teal-50 via-white to-cyan-50 border-b border-gray-200 shadow-lg py-12 lg:py-16 relative overflow-hidden">
  <!-- Subtle Decorative Pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute top-10 left-10 w-72 h-72 bg-teal-500 rounded-full mix-blend-multiply filter blur-xl animate-blob"></div>
    <div class="absolute top-20 right-10 w-72 h-72 bg-cyan-500 rounded-full mix-blend-multiply filter blur-xl animate-blob animation-delay-2000"></div>
    <div class="absolute -bottom-8 left-20 w-72 h-72 bg-blue-500 rounded-full mix-blend-multiply filter blur-xl animate-blob animation-delay-4000"></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 relative">
    <div class="text-center mb-8">
      <h1 class="text-3xl lg:text-5xl font-black mb-4 leading-tight text-gray-900" id="main-title">{title}</h1>
      <p class="text-lg lg:text-xl mb-6 text-gray-700 leading-relaxed max-w-3xl mx-auto" id="main-description">{description}</p>

      <div class="flex flex-col items-center gap-4">
        {audience && audience.length > 0 && (
          <div class="flex flex-wrap justify-center gap-2" role="list" aria-label="Target audiences">
            {audience.map((tag) => (
              tag && (
                <span class="bg-white/80 backdrop-blur text-teal-700 px-4 py-2 rounded-full font-semibold text-sm border border-teal-200 shadow-sm" role="listitem">
                  {capitalize(tag)}
                </span>
              )
            ))}
          </div>
        )}
        <span class="bg-teal-600 text-white px-8 py-3 rounded-full font-bold uppercase tracking-wide text-sm shadow-lg">
          {capitalize(topic)} Resources
        </span>
      </div>
    </div>

    <!-- Contact Section -->
    {(contact.phone || contact.email || contact.location) && (
      <section class="flex justify-center px-4" aria-labelledby="contact-heading">
        <div class="bg-white/90 backdrop-blur border border-teal-200 rounded-2xl p-8 shadow-xl w-full max-w-4xl">
          <div class="text-center mb-6">
            <div class="inline-flex items-center gap-3 mb-2">
              <div class="w-10 h-10 bg-teal-600 rounded-full flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-gray-900" id="contact-heading">Get Help Now</h2>
            </div>
            <p class="text-gray-600">Contact</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {contact.phone && (
              <a href={`tel:${contact.phone}`} class="flex items-center justify-center gap-3 bg-gradient-to-r from-teal-500 to-teal-600 hover:from-teal-600 hover:to-teal-700 text-white rounded-xl px-6 py-4 transition-all group shadow-lg transform hover:scale-105" aria-label={`Call ${contact.phone}`}>
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                </svg>
                <div class="text-left">
                  <div class="font-bold text-sm">Call Now</div>
                  <div class="text-teal-100 text-xs">{contact.phone}</div>
                </div>
              </a>
            )}

            {contact.email && (
              <a href={`mailto:${contact.email}`} class="flex items-center justify-center gap-3 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white rounded-xl px-6 py-4 transition-all group shadow-lg transform hover:scale-105" aria-label={`Email ${contact.email}`}>
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                  <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                </svg>
                <div class="text-left">
                  <div class="font-bold text-sm">Email</div>
                  <div class="text-blue-100 text-xs break-all">{contact.email}</div>
                </div>
              </a>
            )}

            {contact.location && (
              <a href={locationToURL(contact.location)} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-3 bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white rounded-xl px-6 py-4 transition-all group shadow-lg transform hover:scale-105" aria-label={`Visit us at ${contact.location}`}>
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                </svg>
                <div class="text-left">
                  <div class="font-bold text-sm">Visit</div>
                  <div class="text-emerald-100 text-xs">{contact.location}</div>
                </div>
              </a>
            )}
          </div>
        </div>
      </section>
    )}
  </div>
</header>

<!-- Facts and Myths Section - No misleading hover effects -->
{(truths.length > 0 || myths.length > 0) && (
  <section class="py-16 bg-gradient-to-br from-gray-50 to-gray-100" aria-labelledby="info-heading">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4" id="info-heading">Essential Information</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">Get accurate, verified information and learn about common misconceptions that might prevent you from accessing these resources.</p>
      </div>

      <div class="grid lg:grid-cols-2 gap-8">
        <!-- Facts Section -->
        {truths.length > 0 && (
          <article class="bg-white border border-gray-200 rounded-2xl shadow-xl overflow-hidden" aria-labelledby="facts-heading">
            <header class="bg-gradient-to-r from-emerald-500 to-emerald-600 px-8 py-6 relative">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-white/20 backdrop-blur rounded-xl flex items-center justify-center">
                  <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-white" id="facts-heading">Verified Facts</h3>
                  <p class="text-emerald-100 text-sm">Accurate information you can trust</p>
                </div>
              </div>
              <div class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full -mr-16 -mt-16" aria-hidden="true"></div>
            </header>

            <div class="p-8 space-y-6">
              {truths.map((truth) => (
                <div class="flex items-start gap-4 p-6 bg-emerald-50 border-l-4 border-emerald-500 rounded-r-xl">
                  <div class="w-6 h-6 bg-emerald-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                    </svg>
                  </div>
                  <p class="text-gray-900 leading-relaxed font-medium">{truth}</p>
                </div>
              ))}
            </div>
          </article>
        )}

        <!-- Myths Section - Purple as requested, no hover effects -->
        {myths.length > 0 && (
          <article class="bg-white border border-gray-200 rounded-2xl shadow-xl overflow-hidden" aria-labelledby="myths-heading">
            <header class="bg-gradient-to-r from-purple-500 to-purple-600 px-8 py-6 relative">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-white/20 backdrop-blur rounded-xl flex items-center justify-center">
                  <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-white" id="myths-heading">Common Myths</h3>
                  <p class="text-purple-100 text-sm">Misconceptions to avoid</p>
                </div>
              </div>
              <div class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full -mr-16 -mt-16" aria-hidden="true"></div>
            </header>

            <div class="p-8 space-y-6">
              {myths.map((myth) => (
                <div class="flex items-start gap-4 p-6 bg-purple-50 border-l-4 border-purple-500 rounded-r-xl">
                  <div class="w-6 h-6 bg-purple-500 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                      <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                    </svg>
                  </div>
                  <p class="text-gray-900 leading-relaxed font-medium">{myth}</p>
                </div>
              ))}
            </div>
          </article>
        )}
      </div>
    </div>
  </section>
)}

<!-- Clean Article Content Section - Neutral Colors -->
{articleContent && (
  <section class="py-16 bg-white" aria-labelledby="guide-heading">
    <div class="max-w-5xl mx-auto px-4">
      <article class="bg-white border border-gray-200 rounded-2xl shadow-xl overflow-hidden">
        <header class="bg-gray-800 px-8 py-8 relative">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 bg-white/10 backdrop-blur rounded-xl flex items-center justify-center">
                <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-2xl font-bold text-white" id="guide-heading">Complete Resource Guide</h2>
                <p class="text-gray-300">Detailed eligibility requirements and application process</p>
              </div>
            </div>
            <button id="print-article" class="flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white px-6 py-3 rounded-xl font-semibold transition-all backdrop-blur border border-white/20" aria-label="Print complete guide">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M5 4v3H4a2 2 0 00-2 2v3a2 2 0 002 2h1v2a2 2 0 002 2h6a2 2 0 002-2v-2h1a2 2 0 002-2V9a2 2 0 00-2-2h-1V4a2 2 0 00-2-2H7a2 2 0 00-2 2zm8 0H7v3h6V4zM5 14H4v-3h1v3zm6 0H9v2H7v-2H6v3h8v-3h-3zm2-3h1V9h-1v2z" clip-rule="evenodd"></path>
              </svg>
              Print Guide
            </button>
          </div>
          <div class="absolute top-0 right-0 w-40 h-40 bg-white/5 rounded-full -mr-20 -mt-20" aria-hidden="true"></div>
          <div class="absolute bottom-0 left-0 w-24 h-24 bg-white/5 rounded-full -ml-12 -mb-12" aria-hidden="true"></div>
        </header>

        <div class="px-8 py-12">
          <div class="prose prose-lg prose-gray max-w-none">
            <div set:html={articleContent}></div>
          </div>
        </div>
      </article>
    </div>
  </section>
)}

<!-- Footer unchanged as requested -->
<section class="bg-gray-900 text-white py-12 relative overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-teal-500 rounded-full mix-blend-multiply filter blur-3xl" aria-hidden="true"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-blue-500 rounded-full mix-blend-multiply filter blur-3xl" aria-hidden="true"></div>
  </div>

  <div class="max-w-4xl mx-auto px-4 text-center relative">
    <h2 class="text-3xl font-bold mb-6">Ready to Get Help?</h2>
    <div class="flex flex-col sm:flex-row gap-6 justify-center">
      {contact.phone && (
        <a href={`tel:${contact.phone}`} class="bg-teal-600 hover:bg-teal-500 text-white font-bold py-4 px-10 rounded-xl shadow-2xl transition-all transform hover:scale-110 hover:-translate-y-1 flex items-center justify-center gap-3" aria-label={`Call us at ${contact.phone}`}>
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
          </svg>
          Call {contact.phone}
        </a>
      )}
      <a href="/" class="bg-gray-700 hover:bg-gray-600 text-white font-bold py-4 px-10 rounded-xl shadow-2xl transition-all transform hover:scale-110 hover:-translate-y-1 flex items-center justify-center gap-3" aria-label="Find other resources">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
        </svg>
        Find Other Resources
      </a>
    </div>
  </div>
</section>
</div>
</Layout>

<script>
// Font size controls
function setFontSize(size: string) {
  const body = document.body;
  body.classList.remove('text-sm', 'text-base', 'text-lg', 'text-xl', 'text-2xl');

  const title = document.getElementById('main-title');
  const description = document.getElementById('main-description');

  switch(size) {
    case 'small':
      body.classList.add('text-sm');
      title?.classList.remove('text-4xl', 'lg:text-6xl', 'text-5xl', 'lg:text-7xl');
      title?.classList.add('text-3xl', 'lg:text-5xl');
      description?.classList.remove('text-xl', 'lg:text-2xl', 'text-2xl', 'lg:text-3xl');
      description?.classList.add('text-lg', 'lg:text-xl');
      break;
    case 'large':
      body.classList.add('text-xl');
      title?.classList.remove('text-4xl', 'lg:text-6xl', 'text-3xl', 'lg:text-5xl');
      title?.classList.add('text-5xl', 'lg:text-7xl');
      description?.classList.remove('text-xl', 'lg:text-2xl', 'text-lg', 'lg:text-xl');
      description?.classList.add('text-2xl', 'lg:text-3xl');
      break;
    default:
      body.classList.add('text-base');
      title?.classList.remove('text-3xl', 'lg:text-5xl', 'text-5xl', 'lg:text-7xl');
      title?.classList.add('text-4xl', 'lg:text-6xl');
      description?.classList.remove('text-lg', 'lg:text-xl', 'text-2xl', 'lg:text-3xl');
      description?.classList.add('text-xl', 'lg:text-2xl');
  }
}

document.getElementById('font-small')?.addEventListener('click', () => setFontSize('small'));
document.getElementById('font-normal')?.addEventListener('click', () => setFontSize('normal'));
document.getElementById('font-large')?.addEventListener('click', () => setFontSize('large'));

// Print functionality
document.getElementById('print-btn')?.addEventListener('click', () => window.print());
document.getElementById('print-article')?.addEventListener('click', () => window.print());
</script>

<style>
@keyframes blob {
  0% { transform: translate(0px, 0px) scale(1); }
  33% { transform: translate(30px, -50px) scale(1.1); }
  66% { transform: translate(-20px, 20px) scale(0.9); }
  100% { transform: translate(0px, 0px) scale(1); }
}

.animate-blob {
  animation: blob 7s infinite;
}

.animation-delay-2000 {
  animation-delay: 2s;
}

.animation-delay-4000 {
  animation-delay: 4s;
}

@media print {
  .print\\:hidden {
    display: none !important;
  }

  .sticky {
    position: static !important;
  }

  .shadow-sm, .shadow-md, .shadow-lg, .shadow-xl, .shadow-2xl {
    box-shadow: none !important;
  }

  .animate-blob {
    animation: none !important;
  }

  .bg-gradient-to-r, .bg-gradient-to-br {
    background: #374151 !important;
    color: white !important;
  }

  body {
    font-size: 12pt !important;
    line-height: 1.4 !important;
  }

  h1 { font-size: 24pt !important; }
  h2 { font-size: 20pt !important; }
  h3 { font-size: 16pt !important; }
}
</style>