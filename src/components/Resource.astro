---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import type { ManifestItem } from "../utils/manifest";

export interface Props {
  resourceData: ManifestItem;
  articleContent?: string;
  breadcrumbs?: Array<{name: string, href: string}>;
}

const { resourceData, articleContent = '', breadcrumbs = [] } = Astro.props;
const { title, description, audience, topic, contact, truths, myths } = resourceData;

// Capitalize first letter for display
function capitalize(str: string | undefined): string {
  if (!str) return '';
  return str.charAt(0).toUpperCase() + str.slice(1);
}
---

<Layout
  title={title}
  showBreadcrumbs={breadcrumbs.length > 0}
  breadcrumbs={breadcrumbs}
>

<div class="min-h-screen bg-white">
  <!-- Accessibility Controls -->
  <div class="sticky top-16 z-40 bg-gray-800 text-white px-4 py-2 print:hidden">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <div class="flex items-center gap-4">
        <span class="text-sm font-semibold">Text Size:</span>
        <div class="flex gap-1">
          <button id="font-small" class="w-8 h-8 bg-gray-700 hover:bg-gray-600 rounded text-xs font-bold transition-all">A-</button>
          <button id="font-normal" class="w-8 h-8 bg-gray-700 hover:bg-gray-600 rounded text-xs font-bold transition-all">A</button>
          <button id="font-large" class="w-8 h-8 bg-gray-700 hover:bg-gray-600 rounded text-xs font-bold transition-all">A+</button>
        </div>
      </div>
      <button id="print-btn" class="flex items-center gap-2 bg-teal-600 hover:bg-teal-700 px-3 py-1 rounded text-sm font-semibold transition-all">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M5 4v3H4a2 2 0 00-2 2v3a2 2 0 002 2h1v2a2 2 0 002 2h6a2 2 0 002-2v-2h1a2 2 0 002-2V9a2 2 0 00-2-2h-1V4a2 2 0 00-2-2H7a2 2 0 00-2 2zm8 0H7v3h6V4zM5 14H4v-3h1v3zm6 0H9v2H7v-2H6v3h8v-3h-3zm2-3h1V9h-1v2z" clip-rule="evenodd"></path>
        </svg>
        Print
      </button>
    </div>
  </div>

  <!-- Hero Section -->
  <header class="bg-gradient-to-br from-gray-900 via-gray-800 to-teal-900 text-white py-16 lg:py-20">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h1 class="text-4xl lg:text-6xl font-black mb-6 leading-tight" id="main-title">{title}</h1>
      <p class="text-xl lg:text-2xl mb-8 opacity-95 leading-relaxed max-w-4xl mx-auto" id="main-description">{description}</p>

      <div class="flex flex-col items-center gap-6">
        {audience && audience.length > 0 && (
          <div class="flex flex-wrap justify-center gap-3">
            {audience.map((tag) => (
              tag && (
                <span class="bg-teal-500/20 backdrop-blur border border-teal-400/30 text-teal-100 px-4 py-2 rounded-lg font-semibold text-lg">
                  {capitalize(tag)}
                </span>
              )
            ))}
          </div>
        )}
        <span class="bg-gradient-to-r from-teal-500 to-cyan-500 text-white px-6 py-3 rounded-lg font-bold uppercase tracking-widest text-sm shadow-lg">
          {capitalize(topic)}
        </span>
      </div>
    </div>
  </header>

  <!-- Quick Action Bar - Only show if contact info exists -->
  {(contact.phone || contact.email || contact.location) && (
    <section class="bg-white border-b border-gray-200 py-6 shadow-sm">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-6">
          <h2 class="text-2xl font-bold text-gray-900 mb-2">Need Immediate Help?</h2>
          <p class="text-gray-600">Contact our specialists now or visit our office</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 max-w-4xl mx-auto">
          {contact.phone && (
            <a href={`tel:${contact.phone}`} class="group flex items-center gap-4 bg-gradient-to-r from-teal-500 to-teal-600 hover:from-teal-600 hover:to-teal-700 text-white rounded-xl px-6 py-4 shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-1">
              <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                </svg>
              </div>
              <div class="text-left">
                <div class="font-bold text-lg">Call Now</div>
                <div class="font-medium opacity-90">{contact.phone}</div>
                <div class="text-sm opacity-75">Available 24/7</div>
              </div>
            </a>
          )}

          {contact.email && (
            <a href={`mailto:${contact.email}`} class="group flex items-center gap-4 bg-white border-2 border-gray-200 hover:border-teal-300 hover:bg-teal-50 rounded-xl px-6 py-4 shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-1">
              <div class="w-12 h-12 bg-teal-100 rounded-full flex items-center justify-center group-hover:bg-teal-200 transition-colors">
                <svg class="w-6 h-6 text-teal-600" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                  <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                </svg>
              </div>
              <div class="text-left">
                <div class="font-bold text-lg text-gray-900">Email Us</div>
                <div class="font-medium text-teal-600 break-all">{contact.email}</div>
                <div class="text-sm text-gray-500">Response in 24hrs</div>
              </div>
            </a>
          )}

          {contact.location && (
            <div class="flex items-center gap-4 bg-white border-2 border-gray-200 rounded-xl px-6 py-4 shadow-lg">
              <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div class="text-left">
                <div class="font-bold text-lg text-gray-900">Visit Office</div>
                <div class="text-gray-600 text-sm leading-tight">{contact.location}</div>
                <div class="text-sm text-gray-500">Mon-Fri 8AM-5PM</div>
              </div>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Facts and Myths Section - Only show if both exist -->
  {(truths.length > 0 || myths.length > 0) && (
    <section class="py-16">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl lg:text-4xl font-black text-gray-900 mb-4">Know the Facts, Avoid the Myths</h2>
          <p class="text-lg text-gray-600 max-w-3xl mx-auto">Get accurate, verified information and learn about common misconceptions that might prevent you from getting the help you deserve.</p>
        </div>

        <div class="grid lg:grid-cols-2 gap-0 rounded-2xl overflow-hidden shadow-2xl">
          <!-- Facts Section -->
          {truths.length > 0 && (
            <div class="bg-gradient-to-br from-teal-50 via-cyan-50 to-teal-100 p-8 lg:p-12">
              <div class="max-w-lg mx-auto">
                <div class="text-center mb-8">
                  <div class="inline-flex items-center gap-4 mb-4">
                    <div class="w-16 h-16 bg-gradient-to-br from-teal-500 to-teal-600 rounded-full flex items-center justify-center shadow-lg">
                      <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                      </svg>
                    </div>
                    <h3 class="text-2xl lg:text-3xl font-black text-teal-800">Verified Facts</h3>
                  </div>
                  <p class="text-teal-700 font-medium">Accurate information you can trust</p>
                </div>

                <div class="space-y-4">
                  {truths.map((truth) => (
                    <div class="bg-white border border-teal-200 rounded-xl shadow-sm p-6 hover:shadow-md transition-all hover:border-teal-300">
                      <div class="flex items-start gap-4">
                        <div class="w-8 h-8 bg-gradient-to-br from-teal-500 to-teal-600 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5 shadow-sm">
                          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                          </svg>
                        </div>
                        <div>
                          <div class="mb-2">
                            <span class="inline-block bg-teal-100 text-teal-800 text-sm font-bold px-3 py-1 rounded-full">FACT</span>
                          </div>
                          <p class="text-gray-900 text-lg leading-relaxed">{truth}</p>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}

          <!-- Myths Section -->
          {myths.length > 0 && (
            <div class="bg-gradient-to-br from-purple-50 via-indigo-50 to-purple-100 p-8 lg:p-12">
              <div class="max-w-lg mx-auto">
                <div class="text-center mb-8">
                  <div class="inline-flex items-center gap-4 mb-4">
                    <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-purple-600 rounded-full flex items-center justify-center shadow-lg">
                      <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                      </svg>
                    </div>
                    <h3 class="text-2xl lg:text-3xl font-black text-purple-800">Common Myths</h3>
                  </div>
                  <p class="text-purple-700 font-medium">Misconceptions to avoid</p>
                </div>

                <div class="space-y-4">
                  {myths.map((myth) => (
                    <div class="bg-white border border-purple-200 rounded-xl shadow-sm p-6 hover:shadow-md transition-all hover:border-purple-300">
                      <div class="flex items-start gap-4">
                        <div class="w-8 h-8 bg-gradient-to-br from-purple-500 to-purple-600 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5 shadow-sm">
                          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                          </svg>
                        </div>
                        <div>
                          <div class="mb-2">
                            <span class="inline-block bg-purple-100 text-purple-800 text-sm font-bold px-3 py-1 rounded-full">MYTH</span>
                          </div>
                          <p class="text-gray-900 text-lg leading-relaxed">{myth}</p>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Complete Guide Section - Only show if article content exists -->
  {articleContent && (
    <section class="bg-gradient-to-br from-gray-50 to-gray-100 py-16">
      <div class="max-w-5xl mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl lg:text-4xl font-black text-gray-900 mb-4">Complete Resource Guide</h2>
          <p class="text-lg text-gray-600 max-w-3xl mx-auto">Everything you need to know about eligibility requirements, application processes, and available programs.</p>
        </div>

        <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
          <div class="bg-gradient-to-r from-teal-600 to-cyan-600 px-8 py-6">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-xl lg:text-2xl font-bold text-white">Comprehensive Guide</h3>
                <p class="text-teal-100">Get the help you need with our detailed resource information</p>
              </div>
              <button id="print-article" class="flex items-center gap-2 bg-white/20 hover:bg-white/30 text-white px-4 py-2 rounded-lg font-semibold transition-all backdrop-blur">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5 4v3H4a2 2 0 00-2 2v3a2 2 0 002 2h1v2a2 2 0 002 2h6a2 2 0 002-2v-2h1a2 2 0 002-2V9a2 2 0 00-2-2h-1V4a2 2 0 00-2-2H7a2 2 0 00-2 2zm8 0H7v3h6V4zM5 14H4v-3h1v3zm6 0H9v2H7v-2H6v3h8v-3h-3zm2-3h1V9h-1v2z" clip-rule="evenodd"></path>
                </svg>
                Print Guide
              </button>
            </div>
          </div>

          <div class="px-8 py-12">
            <div class="prose prose-lg max-w-none">
              <div set:html={articleContent}></div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Quick Actions Footer -->
  <section class="bg-gray-900 text-white py-8">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h3 class="text-2xl font-bold mb-4">Ready to Get Help?</h3>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        {contact.phone && (
          <a href={`tel:${contact.phone}`} class="bg-teal-600 hover:bg-teal-700 text-white font-semibold py-3 px-8 rounded-lg shadow-lg transition-all transform hover:scale-105 flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
            </svg>
            Call {contact.phone}
          </a>
        )}
        <a href="/" class="bg-gray-700 hover:bg-gray-600 text-white font-semibold py-3 px-8 rounded-lg shadow-lg transition-all transform hover:scale-105 flex items-center justify-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
          </svg>
          Find Other Resources
        </a>
      </div>
    </div>
  </section>
</div>
</Layout>

<script>
// Font size controls
function setFontSize(size: string) {
  const body = document.body;
  body.classList.remove('text-sm', 'text-base', 'text-lg', 'text-xl', 'text-2xl');

  const title = document.getElementById('main-title');
  const description = document.getElementById('main-description');

  switch(size) {
    case 'small':
      body.classList.add('text-sm');
      title?.classList.remove('text-4xl', 'lg:text-6xl', 'text-5xl', 'lg:text-7xl');
      title?.classList.add('text-3xl', 'lg:text-5xl');
      description?.classList.remove('text-xl', 'lg:text-2xl', 'text-2xl', 'lg:text-3xl');
      description?.classList.add('text-lg', 'lg:text-xl');
      break;
    case 'large':
      body.classList.add('text-xl');
      title?.classList.remove('text-4xl', 'lg:text-6xl', 'text-3xl', 'lg:text-5xl');
      title?.classList.add('text-5xl', 'lg:text-7xl');
      description?.classList.remove('text-xl', 'lg:text-2xl', 'text-lg', 'lg:text-xl');
      description?.classList.add('text-2xl', 'lg:text-3xl');
      break;
    default:
      body.classList.add('text-base');
      title?.classList.remove('text-3xl', 'lg:text-5xl', 'text-5xl', 'lg:text-7xl');
      title?.classList.add('text-4xl', 'lg:text-6xl');
      description?.classList.remove('text-lg', 'lg:text-xl', 'text-2xl', 'lg:text-3xl');
      description?.classList.add('text-xl', 'lg:text-2xl');
  }
}

document.getElementById('font-small')?.addEventListener('click', () => setFontSize('small'));
document.getElementById('font-normal')?.addEventListener('click', () => setFontSize('normal'));
document.getElementById('font-large')?.addEventListener('click', () => setFontSize('large'));

// Print functionality
document.getElementById('print-btn')?.addEventListener('click', () => window.print());
document.getElementById('print-article')?.addEventListener('click', () => window.print());
</script>

<style>
@media print {
  .print\\:hidden {
    display: none !important;
  }

  .sticky {
    position: static !important;
  }

  .shadow-sm, .shadow-md, .shadow-lg, .shadow-xl, .shadow-2xl {
    box-shadow: none !important;
  }

  .bg-gradient-to-r, .bg-gradient-to-br {
    background: #374151 !important;
    color: white !important;
  }

  body {
    font-size: 12pt !important;
    line-height: 1.4 !important;
  }

  h1 { font-size: 24pt !important; }
  h2 { font-size: 20pt !important; }
  h3 { font-size: 16pt !important; }
}
</style>